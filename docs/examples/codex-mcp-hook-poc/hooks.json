{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "ai_security_runtime",
            "tool": "handle_hook_event",
            "input": {
              "event": "${hook_event_name}",
              "workspace_path": "${cwd}",
              "session_id": "${session_id}",
              "tool_name": "${tool_name}"
            },
            "timeout": 120,
            "statusMessage": "AI Security Runtime [mcp-hook-poc]"
          }
        ]
      }
    ]
  }
}
